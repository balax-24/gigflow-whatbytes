rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidTask(data) {
      let keys = ['title', 'description', 'dueDate', 'priority',
                  'isCompleted', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(keys)
          && data.keys().hasOnly(keys.concat(['category']))
          && (!('category' in data)
              || data.category in ['delivery', 'ride', 'errand', 'work', 'personal', 'general'])
          && data.title is string && data.title.size() > 0 && data.title.size() <= 200
          && data.description is string && data.description.size() <= 1000
          && data.dueDate is timestamp
          && data.priority in ['low', 'medium', 'high']
          && data.isCompleted is bool
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
    }

    // Tenant isolation: a signed-in user can only touch their own subtree.
    match /users/{userId}/tasks/{taskId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId)
                    && taskId.size() <= 128
                    && isValidTask(request.resource.data);
      // Integrity: createdAt is immutable once written.
      allow update: if isOwner(userId)
                    && isValidTask(request.resource.data)
                    && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
